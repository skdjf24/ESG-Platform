# Server-only. Never prefix secrets with NEXT_PUBLIC_ or commit a real value.
# Public Preview default: leave the provider unconfigured. The application and
# deterministic quality checks continue to work without AI.
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Local-only LM Studio example (never use localhost for a public deployment):
# AI_PROVIDER=lmstudio
# AI_BASE_URL=http://127.0.0.1:1234/v1
# AI_MODEL=<local-model>
# AI_API_KEY=

# OpenAI example:
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=<model>
# AI_API_KEY=<server-secret>

# Backward-compatible OpenAI variables. AI_MODEL / AI_API_KEY take priority.
OPENAI_MODEL=
OPENAI_API_KEY=
